%% Target architecture for CubicaWorld — hand-authored design (NOT generated by clang-uml;
%% cubica_class.mmd remains the generated as-built diagram).
%% Covers full README scope: greedy meshing, frustum culling, occlusion culling,
%% Perlin terrain, player physics/collision, voxel raycast block edit, benchmarking.
%% Unchanged existing classes (Shader, Texture, VAO, VBO, EBO, ChunkMesh, MeshData,
%% ChunkVertex, BlockType, ChunkCoord, ChunkState, ChunkNeighbors) shown collapsed.

classDiagram
    direction TB

    %% ============ Application layer ============
    class Application {
        +Run() void
        -ProcessFrame(float dt) void
        -window_ : GLFWwindow*
        -chunkManager_ : ChunkManager
        -renderer_ : ChunkRenderer
        -player_ : Player
        -settings_ : RenderSettings
        -stats_ : FrameStats
    }

    class RenderSettings {
        +greedyMeshing : bool
        +frustumCulling : bool
        +occlusionCulling : bool
        +multithreading : bool
        +viewDistance : int
    }

    class FrameStats {
        +BeginFrame() void
        +EndFrame() void
        +WriteCSV(const std::string& path) void
        +frameMs : float
        +drawCalls : int
        +verticesSubmitted : size_t
        +chunksRendered : int
        +chunksCulledFrustum : int
        +chunksCulledOcclusion : int
        +jobsRunWorkers : int
        +jobsRunMainThread : int
        +jobQueueDepth : int
    }

    %% ============ Player / interaction ============
    class Player {
        +Player(glm::vec3 spawn)
        +ProcessInput(GLFWwindow* window, float dt) void
        +Update(float dt, const ChunkManager& world) void
        +GetCamera() Camera&
        -ResolveCollision(const ChunkManager& world) void
        -position_ : glm::vec3
        -velocity_ : glm::vec3
        -bounds_ : AABB
        -onGround_ : bool
        -camera_ : Camera
    }

    class Camera {
        <<slimmed: math only, input moved to Player>>
        +SetPose(glm::vec3 pos, glm::vec3 front) void
        +UpdateMatrix(float fov, float near, float far) void
        +Matrix() const glm::mat4&
    }

    class AABB {
        +min : glm::vec3
        +max : glm::vec3
        +Intersects(const AABB& o) bool
        +Translated(glm::vec3 offset) AABB
    }

    class VoxelRaycaster {
        <<static utility — Amanatides-Woo DDA>>
        +Cast(const ChunkManager& world, glm::vec3 origin, glm::vec3 dir, float maxDist)$ RaycastHit
    }

    class RaycastHit {
        +hit : bool
        +block : glm::ivec3
        +faceNormal : glm::ivec3
        +type : BlockType
    }

    %% ============ World data & streaming (existing pipeline kept) ============
    class ChunkManager {
        <<keeps thread pool + shared_ptr lifetime model; threaded_ off = workers park, Update() drains jobs with per-frame budget>>
        +Update(const glm::vec3& cameraPos) void
        +GetBlockWorld(glm::ivec3 worldPos) BlockType
        +SetBlockWorld(glm::ivec3 worldPos, BlockType type) void
        +GetChunk(ChunkCoord) std::shared_ptr~const Chunk~
        +GatherNeighbors(ChunkCoord) ChunkNeighbors
        +DrainUploads(int maxPerFrame) void
        +VisitRenderable(visitor) void
        -EnqueueWork(std::function~void()~) void
        -maxJobsPerFrame_ : int
        -chunks_ : unordered_map~ChunkCoord, shared_ptr~Chunk~~
        -generator_ : TerrainGenerator
        -mesher_ : IMesher*
        -workers_ : std::vector~std::thread~
        -workQueue_ / uploadQueue_ / mutexes
    }

    class Chunk {
        <<data + state only: Generate/BuildMesh/Render moved out>>
        +GetBlock(int x, int y, int z) BlockType
        +SetBlock(int x, int y, int z, BlockType) void
        +State() ChunkState
        +MarkDirty() void
        +UploadIfReady() void
        +Bounds() AABB
        +Mesh() const ChunkMesh&
        -blocks_ : unique_ptr~BlockType[]~
        -state_ : atomic~ChunkState~
        -coord_ : ChunkCoord
        -pendingMesh_ : MeshData
        -chunkMesh_ : ChunkMesh
    }

    %% ============ Terrain generation ============
    class TerrainGenerator {
        +TerrainGenerator(uint32_t seed)
        +Generate(Chunk& chunk) void
        -HeightAt(int worldX, int worldZ) int
        -noise_ : PerlinNoise
        -seed_ : uint32_t
        -octaves_ : int
        -lacunarity_ : float
        -persistence_ : float
    }

    class PerlinNoise {
        +PerlinNoise(uint32_t seed)
        +Noise2D(float x, float y) float
        +FBm(float x, float y, int octaves) float
        -perm_ : std::array~uint8_t, 512~
    }

    %% ============ Meshing (strategy for benchmarking) ============
    class IMesher {
        <<interface>>
        +Build(const Chunk& chunk, const ChunkNeighbors& n, const TextureManager& tex)* MeshData
    }

    class NaiveMesher {
        <<current per-face culling — kept as benchmark baseline>>
        +Build(...) MeshData
    }

    class GreedyMesher {
        +Build(...) MeshData
        -MergeSlice(axis, layer) void
    }

    class TextureManager {
        <<GL_TEXTURE_2D_ARRAY, replaces per-chunk Texture list>>
        +Load(const std::string& atlasDir) void
        +Bind(GLuint unit) void
        +LayerFor(BlockType type, int face) uint8_t
        -arrayID_ : GLuint
    }

    %% ============ Rendering & culling ============
    class ChunkRenderer {
        <<all GL draw/cull moved here from Chunk/ChunkManager>>
        +Render(ChunkManager& world, const Camera& cam, const Shader& shader, const RenderSettings& s, FrameStats& out) void
        -frustum_ : Frustum
        -occlusion_ : OcclusionCuller
    }

    class Frustum {
        +FromMatrix(const glm::mat4& viewProj)$ Frustum
        +Intersects(const AABB& box) bool
        -planes_ : std::array~glm::vec4, 6~
    }

    class OcclusionCuller {
        <<GL_ANY_SAMPLES_PASSED queries on chunk AABBs, 1-frame latency>>
        +TestAndDraw(ChunkCoord coord, const AABB& box) bool
        +ResolveResults() void
        -queries_ : unordered_map~ChunkCoord, GLuint~
        -visibleLastFrame_ : unordered_set~ChunkCoord~
    }

    %% ============ Existing, unchanged ============
    class ChunkMesh { <<unchanged>> }
    class MeshData { <<unchanged>> }
    class Shader { <<unchanged>> }
    class ChunkNeighbors { <<unchanged>> }
    class BlockType { <<enumeration, unchanged>> }
    class ChunkState { <<enumeration, unchanged>> }

    %% ============ Relationships ============
    Application *-- ChunkManager
    Application *-- ChunkRenderer
    Application *-- Player
    Application *-- RenderSettings
    Application *-- FrameStats
    Application ..> VoxelRaycaster : block place/break input

    Player *-- Camera
    Player *-- AABB
    Player ..> ChunkManager : collision queries (GetBlockWorld)

    VoxelRaycaster ..> ChunkManager
    VoxelRaycaster ..> RaycastHit : returns
    RaycastHit ..> BlockType

    ChunkManager *-- TerrainGenerator
    ChunkManager o-- IMesher : selected via RenderSettings
    ChunkManager o-- Chunk : chunks_ (shared_ptr)
    ChunkManager ..> ChunkNeighbors
    ChunkManager ..> RenderSettings : threading + mesher toggles
    ChunkManager ..> FrameStats : job counters

    TerrainGenerator *-- PerlinNoise
    TerrainGenerator ..> Chunk : fills blocks

    IMesher <|.. NaiveMesher
    IMesher <|.. GreedyMesher
    IMesher ..> MeshData : produces
    IMesher ..> TextureManager : texLayer lookup
    IMesher ..> ChunkNeighbors

    Chunk *-- ChunkMesh
    Chunk *-- MeshData : pendingMesh_
    Chunk ..> ChunkState
    Chunk ..> BlockType

    ChunkRenderer *-- Frustum
    ChunkRenderer *-- OcclusionCuller
    ChunkRenderer ..> ChunkManager : VisitRenderable
    ChunkRenderer ..> TextureManager : bind array
    ChunkRenderer ..> Shader
    ChunkRenderer ..> Camera
    ChunkRenderer ..> FrameStats : records
    ChunkRenderer ..> RenderSettings : toggles

    Frustum ..> AABB
    OcclusionCuller ..> AABB


